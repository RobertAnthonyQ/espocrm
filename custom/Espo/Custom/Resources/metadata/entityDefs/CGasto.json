{
    "fields": {
        "name": {
            "type": "varchar",
            "required": true,
            "pattern": "$noBadCharacters"
        },
        "description": {
            "type": "text"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        },
        "createdBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "modifiedBy": {
            "type": "link",
            "readOnly": true,
            "view": "views/fields/user"
        },
        "assignedUser": {
            "type": "link",
            "required": false,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "documentType": {
            "type": "enum",
            "required": true,
            "options": [
                "Factura",
                "Boleta",
                "Recibo por honorarios",
                "Nota de crédito",
                "Otro"
            ],
            "default": "Factura",
            "displayAsLabel": true,
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "documentNumber": {
            "type": "varchar",
            "required": true,
            "maxLength": 50,
            "copyToClipboard": true,
            "audited": true,
            "isCustom": true
        },
        "issueDate": {
            "notNull": false,
            "type": "date",
            "required": true,
            "audited": true,
            "isCustom": true
        },
        "dueDate": {
            "notNull": false,
            "type": "date",
            "audited": true,
            "isCustom": true
        },
        "category": {
            "type": "enum",
            "required": true,
            "options": [
                "Operaciones",
                "Logística y transporte",
                "Tecnología",
                "Marketing",
                "Servicios profesionales",
                "Alquiler y servicios",
                "Recursos humanos",
                "Tributos",
                "Otros"
            ],
            "displayAsLabel": true,
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "costCenter": {
            "type": "enum",
            "required": true,
            "options": [
                "Dirección General",
                "Ventas",
                "Operaciones",
                "Logística",
                "Finanzas",
                "Servicio al Cliente",
                "Tecnología",
                "Recursos Humanos"
            ],
            "displayAsLabel": true,
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "subtotal": {
            "type": "currency",
            "required": true,
            "min": 0,
            "audited": true,
            "isCustom": true
        },
        "taxAmount": {
            "type": "currency",
            "required": true,
            "min": 0,
            "audited": true,
            "isCustom": true
        },
        "totalAmount": {
            "type": "currency",
            "required": true,
            "min": 0,
            "audited": true,
            "isCustom": true
        },
        "paymentStatus": {
            "type": "enum",
            "required": true,
            "options": [
                "Registrado",
                "Pendiente de pago",
                "Pagado",
                "Anulado"
            ],
            "default": "Registrado",
            "displayAsLabel": true,
            "audited": true,
            "style": {
                "Registrado": "info",
                "Pendiente de pago": "warning",
                "Pagado": "success",
                "Anulado": "danger"
            },
            "maxLength": 100,
            "isCustom": true
        },
        "paymentMethod": {
            "type": "enum",
            "options": [
                "Transferencia bancaria",
                "Tarjeta corporativa",
                "Caja chica",
                "Débito automático",
                "Otro"
            ],
            "displayAsLabel": true,
            "audited": true,
            "maxLength": 100,
            "isCustom": true
        },
        "paymentDate": {
            "notNull": false,
            "type": "date",
            "audited": true,
            "isCustom": true
        },
        "invoiceFile": {
            "type": "file",
            "view": "custom:views/fields/pdf-embed",
            "required": true,
            "accept": [
                ".pdf"
            ],
            "maxFileSize": 20,
            "audited": true,
            "isCustom": true
        },
        "xmlFile": {
            "type": "file",
            "accept": [
                ".xml",
                "text/xml",
                "application/xml"
            ],
            "maxFileSize": 10,
            "audited": true,
            "isCustom": true
        },
        "deductible": {
            "notNull": true,
            "type": "bool",
            "default": true,
            "audited": true,
            "isCustom": true
        },
        "proveedor": {
            "type": "link"
        },
        "pedido": {
            "type": "link"
        }
    },
    "links": {
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "meetings": {
            "type": "hasMany",
            "entity": "Meeting",
            "foreign": "parent"
        },
        "calls": {
            "type": "hasMany",
            "entity": "Call",
            "foreign": "parent"
        },
        "tasks": {
            "type": "hasChildren",
            "entity": "Task",
            "foreign": "parent"
        },
        "emails": {
            "type": "hasChildren",
            "entity": "Email",
            "foreign": "parent",
            "layoutRelationshipsDisabled": true
        },
        "invoiceFile": {
            "type": "belongsTo",
            "entity": "Attachment",
            "skipOrmDefs": true,
            "utility": true
        },
        "xmlFile": {
            "type": "belongsTo",
            "entity": "Attachment",
            "skipOrmDefs": true,
            "utility": true
        },
        "proveedor": {
            "type": "belongsTo",
            "foreign": "cCGastos",
            "entity": "Account",
            "audited": false,
            "isCustom": true
        },
        "pedido": {
            "type": "belongsTo",
            "foreign": "cCGastos",
            "entity": "Opportunity",
            "audited": false,
            "isCustom": true
        }
    },
    "collection": {
        "orderBy": "createdAt",
        "order": "desc"
    },
    "indexes": {
        "name": {
            "columns": [
                "name",
                "deleted"
            ]
        },
        "assignedUser": {
            "columns": [
                "assignedUserId",
                "deleted"
            ]
        },
        "createdAt": {
            "columns": [
                "createdAt"
            ]
        },
        "createdAtId": {
            "unique": true,
            "columns": [
                "createdAt",
                "id"
            ]
        }
    }
}
